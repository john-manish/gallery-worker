const TOKEN_URL =
  "https://oauth2.googleapis.com/token";

const DRIVE_API =
  "https://www.googleapis.com/drive/v3";

let cachedToken = null;
let tokenExpiresAt = 0;


// =========================================================
// GOOGLE OAUTH2
// Same authentication model as the old backend:
// GOOGLE_CLIENT_ID
// GOOGLE_CLIENT_SECRET
// GOOGLE_REFRESH_TOKEN
// =========================================================

async function getAccessToken(env) {

  if (
    cachedToken &&
    Date.now() < tokenExpiresAt
  ) {
    return cachedToken;
  }


  if (!env.GOOGLE_CLIENT_ID) {

    throw new Error(
      "GOOGLE_CLIENT_ID is missing"
    );

  }


  if (!env.GOOGLE_CLIENT_SECRET) {

    throw new Error(
      "GOOGLE_CLIENT_SECRET is missing"
    );

  }


  if (!env.GOOGLE_REFRESH_TOKEN) {

    throw new Error(
      "GOOGLE_REFRESH_TOKEN is missing"
    );

  }


  const body =
    new URLSearchParams({

      client_id:
        env.GOOGLE_CLIENT_ID,

      client_secret:
        env.GOOGLE_CLIENT_SECRET,

      refresh_token:
        env.GOOGLE_REFRESH_TOKEN,

      grant_type:
        "refresh_token"

    });


  const response =
    await fetch(
      TOKEN_URL,
      {
        method: "POST",

        headers: {
          "content-type":
            "application/x-www-form-urlencoded"
        },

        body
      }
    );


  if (!response.ok) {

    const error =
      await response.text();

    throw new Error(
      `Google OAuth token request failed: ${response.status} ${error}`
    );

  }


  const data =
    await response.json();


  if (!data.access_token) {

    throw new Error(
      "Google OAuth token response did not contain access_token"
    );

  }


  cachedToken =
    data.access_token;


  tokenExpiresAt =
    Date.now() +
    (
      (data.expires_in || 3600) - 60
    ) * 1000;


  return cachedToken;

}


// =========================================================
// DRIVE FETCH
// =========================================================

export async function driveFetch(
  env,
  path,
  options = {}
) {

  const token =
    await getAccessToken(env);


  const headers =
    new Headers(
      options.headers || {}
    );


  headers.set(
    "authorization",
    `Bearer ${token}`
  );


  return fetch(
    `${DRIVE_API}${path}`,
    {
      ...options,
      headers
    }
  );

}


// =========================================================
// CHECKED DRIVE FETCH
// =========================================================

async function checkedDriveFetch(
  env,
  path,
  options = {}
) {

  const response =
    await driveFetch(
      env,
      path,
      options
    );


  if (!response.ok) {

    const error =
      await response.text();


    throw new Error(
      `Google Drive API failed: ${response.status} ${error}`
    );

  }


  return response;

}


// =========================================================
// GET FILE
// =========================================================

export async function getDriveFile(
  env,
  fileId
) {

  const response =
    await checkedDriveFetch(
      env,
      `/files/${encodeURIComponent(fileId)}?fields=id,name,mimeType,size,modifiedTime,createdTime,parents`
    );


  return response.json();

}


// =========================================================
// LIST FILES
//
// Optional pagination parameters were added so the article
// provider can reproduce the old backend's nextPageToken
// behavior without breaking existing callers.
// =========================================================

export async function listDriveFiles(
  env,
  query,
  fields =
    "files(id,name,mimeType,size,modifiedTime,createdTime,parents)",
  pageToken = null,
  pageSize = 1000
) {

  const params =
    new URLSearchParams({

      q:
        query,

      fields,

      pageSize:
        String(pageSize)

    });


  if (pageToken) {

    params.set(
      "pageToken",
      pageToken
    );

  }


  const response =
    await checkedDriveFetch(
      env,
      `/files?${params.toString()}`
    );


  return response.json();

}


// =========================================================
// DOWNLOAD FILE
// =========================================================

export async function downloadDriveFile(
  env,
  fileId
) {

  return checkedDriveFetch(
    env,
    `/files/${encodeURIComponent(fileId)}?alt=media`
  );

}


// =========================================================
// UPDATE FILE METADATA
// =========================================================

export async function updateDriveFile(
  env,
  fileId,
  body,
  mimeType = "application/json"
) {

  const response =
    await checkedDriveFetch(
      env,
      `/files/${encodeURIComponent(fileId)}`,
      {
        method: "PATCH",

        headers: {
          "content-type":
            mimeType
        },

        body
      }
    );


  return response.json();

}


// =========================================================
// CREATE FILE
// =========================================================

export async function createDriveFile(
  env,
  name,
  parentId,
  body,
  mimeType = "application/json"
) {

  const metadata = {

    name,

    parents: [
      parentId
    ],

    mimeType

  };


  const boundary =
    `----GalleryWorker${crypto.randomUUID()}`;


  const encoder =
    new TextEncoder();


  const metadataPart =
    JSON.stringify(
      metadata
    );


  const bodyBytes =
    typeof body === "string"
      ? encoder.encode(body)
      : body;


  const prefix =
    encoder.encode(

      `--${boundary}\r\n` +

      `Content-Type: application/json; charset=UTF-8\r\n\r\n` +

      `${metadataPart}\r\n` +

      `--${boundary}\r\n` +

      `Content-Type: ${mimeType}\r\n\r\n`

    );


  const suffix =
    encoder.encode(
      `\r\n--${boundary}--\r\n`
    );


  const combined =
    new Uint8Array(

      prefix.byteLength +

      bodyBytes.byteLength +

      suffix.byteLength

    );


  combined.set(
    prefix,
    0
  );


  combined.set(
    bodyBytes,
    prefix.byteLength
  );


  combined.set(
    suffix,
    prefix.byteLength +
      bodyBytes.byteLength
  );


  const response =
    await checkedDriveFetch(
      env,
      "/files?uploadType=multipart&fields=id,name,mimeType,createdTime,modifiedTime",
      {
        method: "POST",

        headers: {

          "content-type":
            `multipart/related; boundary=${boundary}`

        },

        body:
          combined

      }
    );


  return response.json();

}


// =========================================================
// UPDATE FILE MEDIA
// =========================================================

export async function updateDriveFileMedia(
  env,
  fileId,
  body,
  mimeType = "application/json"
) {

  const response =
    await checkedDriveFetch(
      env,
      `/files/${encodeURIComponent(fileId)}?uploadType=media`,
      {
        method: "PATCH",

        headers: {

          "content-type":
            mimeType

        },

        body

      }
    );


  return response.json();

}